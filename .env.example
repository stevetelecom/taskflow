# =====================================================================
# Modele des variables d'environnement TaskFlow
# Copiez ce fichier vers .env puis renseignez vos valeurs :
#   cp .env.example .env
# =====================================================================

# --- Base de donnees MySQL (backend Spring Boot) ---
DB_USERNAME=todo_user
DB_PASSWORD=changez-moi

# --- JWT ---
# Generez une chaine aleatoire de 64+ caracteres : openssl rand -hex 48
JWT_SECRET=changez-moi-64-caracteres-minimum
JWT_EXPIRATION_MS=86400000

# --- Frontend (Vite) : URL de l'API (vide en dev, proxy Vite) ---
VITE_API_URL=
